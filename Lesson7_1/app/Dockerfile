# ╔══════════════════════════════════════════════════════════════════╗
# ║           MULTI-STAGE DOCKERFILE — DevOps Landing               ║
# ║  Методології автоматизованого розгортання ІТ інфраструктури     ║
# ╚══════════════════════════════════════════════════════════════════╝
#
# Багатоетапна збірка (multi-stage build) дозволяє:
#   1. Встановити залежності та зібрати проект у "важкому" build-образі
#   2. Скопіювати лише готові артефакти у легкий production-образ
#   Результат: маленький фінальний image без зайвих dev-інструментів
#
# ─────────────────────────────────────────────────────────────────────
# STAGE 1 — BUILD
# Базовий образ: офіційний Node.js 20 на базі Alpine Linux
#   - node:20-alpine ~ 50 МБ (набагато легший за node:20 ~ 350 МБ)
#   - Alpine — мінімалістичний дистрибутив Linux
# ─────────────────────────────────────────────────────────────────────
FROM node:20-alpine AS builder

# WORKDIR — встановлює робочу директорію всередині контейнера.
# Усі наступні команди (COPY, RUN) виконуються в /app.
# Якщо директорія не існує — Docker створить її автоматично.
WORKDIR /app

# COPY package.json окремо від решти коду — ключовий прийом кешування.
#
# Docker будує образ пошарово. Якщо шар не змінився — він береться з кешу.
# package.json змінюється рідше ніж вихідний код, тому:
#   - змінили лише JS/CSS → шар з npm install НЕ перезбирається (економія часу)
#   - змінили package.json → npm install запускається заново (правильна поведінка)
COPY package.json ./

# RUN виконує команду всередині контейнера під час збірки image.
# npm install читає package.json і встановлює всі залежності у node_modules/.
# Результат фіксується як окремий шар образу.
RUN npm install

# Тепер копіюємо весь вихідний код проекту.
# Це окремий шар — при зміні коду лише він інвалідується,
# а шар з npm install залишається з кешу.
COPY . .

# npm run build запускає vite build (визначено у package.json → scripts.build).
# Vite компілює, мінімізує та оптимізує вихідні файли.
# Результат збірки потрапляє у папку /app/dist/
RUN npm run build

# ─────────────────────────────────────────────────────────────────────
# STAGE 2 — SERVE
# Базовий образ: офіційний Nginx на Alpine Linux
#   - nginx:alpine ~ 8 МБ
#   - Nginx — швидкий веб-сервер, ідеальний для роздачі статичних файлів
# З попереднього (builder) stage у цей образ потрапить лише /app/dist/
# ─────────────────────────────────────────────────────────────────────
FROM nginx:alpine AS production

# COPY --from=builder копіює файли з іменованого попереднього stage.
# Беремо готові статичні файли зі збірки і кладемо їх у стандартну
# директорію Nginx для статичного контенту.
# Node.js, npm, node_modules — нічого з цього у фінальний образ НЕ потрапить.
COPY --from=builder /app/dist /usr/share/nginx/html

# EXPOSE документує, який порт контейнер очікує приймати трафік.
# Це метадані — реальне пробрасування портів задається при docker run -p.
# Nginx за замовчуванням слухає на порту 80.
EXPOSE 80

# CMD — команда, яка запускається при старті контейнера.
# "daemon off" — запускає Nginx у foreground режимі (обов'язково для Docker,
# бо контейнер завершується коли завершується головний процес).
CMD ["nginx", "-g", "daemon off;"]
